# Copy to .env and fill in. .env is gitignored and must stay that way.
#
#     cp .env.example .env
#
# Nothing here is required. With no key at all the pipeline runs end to end on
# the offline judge, which is how the demo works on a fresh clone.

# Tier 2 judge. Set whichever you have; if both are set, Anthropic wins.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Force a provider when both keys are present: anthropic | openai
# CP_JUDGE_PROVIDER=

# Gateway upstream: mock | openai | anthropic
# CP_UPSTREAM=mock
# CP_API_KEY=
